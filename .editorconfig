# EditorConfig — consistent whitespace across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ sources — 4-space indent (see .clang-format for the full style).
[*.{cpp,hpp,h,cc,cxx}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

[*.py]
indent_size = 4

# JSON / JSONC config matrices — 2-space is the JSON convention.
[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# (no exceptions — this project doesn't use two-space Markdown hard line breaks)
