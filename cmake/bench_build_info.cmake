# ============================================================================
# Generates bench_build_info.hpp: build-time facts that the binary embeds in
# every result file's context (see common/harness/bench_metadata.cpp).
#
# Run as a script (cmake -P) on every build rather than once at configure time,
# so the recorded rpp-bench commit can't go stale after a pull/commit without a
# re-configure. The header is only rewritten when its content changes, so an
# unchanged tree doesn't trigger a recompile.
#
# Inputs (-D): SRC_DIR, OUT_FILE, ROCM_PATH, RPP_BACKEND.
# ============================================================================
set(GIT_SHA "unknown")
set(GIT_DIRTY "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
                    WORKING_DIRECTORY "${SRC_DIR}"
                    OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE _rc ERROR_QUIET)
    if(_rc EQUAL 0)
        set(GIT_SHA "${_sha}")
        # Uncommitted changes to tracked files mean the SHA alone doesn't
        # describe what was built.
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
                        WORKING_DIRECTORY "${SRC_DIR}"
                        OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE
                        ERROR_QUIET)
        if(NOT _status STREQUAL "")
            set(GIT_DIRTY "-dirty")
        endif()
    endif()
endif()

# ROCm installs record their version in <ROCM_PATH>/.info/version.
set(ROCM_VERSION "unknown")
if(EXISTS "${ROCM_PATH}/.info/version")
    file(STRINGS "${ROCM_PATH}/.info/version" _ver LIMIT_COUNT 1)
    if(_ver)
        set(ROCM_VERSION "${_ver}")
    endif()
endif()

set(_content "// Generated by cmake/bench_build_info.cmake - do not edit.
#ifndef RPP_BENCH_BUILD_INFO_HPP
#define RPP_BENCH_BUILD_INFO_HPP
#define RPP_BENCH_GIT_SHA \"${GIT_SHA}${GIT_DIRTY}\"
#define RPP_BENCH_ROCM_PATH \"${ROCM_PATH}\"
#define RPP_BENCH_ROCM_VERSION \"${ROCM_VERSION}\"
#define RPP_BENCH_RPP_BACKEND \"${RPP_BACKEND}\"
#endif
")

set(_old "")
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" _old)
endif()
if(NOT _old STREQUAL _content)
    file(WRITE "${OUT_FILE}" "${_content}")
endif()
