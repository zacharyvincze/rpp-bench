{
  "iterations": 5,
  "defaults": {
    "backends": ["HOST", "HIP"],
    "dtypes": ["U8"],
    "layouts": ["PKD3"],
    "batch_sizes": [1],
    "image_sizes": [[224, 224]]
  },
  "ops": [
    { "name": "copy", "library": "rpp" },
    { "name": "brightness", "library": "rpp", "params": { "alpha": 1.75, "beta": 50 } },
    { "name": "gamma_correction", "library": "rpp", "params": { "gamma": 0.5 } },
    { "name": "contrast", "library": "rpp", "params": { "factor": 2.96, "center": 128 } },
    { "name": "exposure", "library": "rpp", "params": { "factor": 1.5 } },
    { "name": "hue", "library": "rpp", "params": { "hue": 90 } },
    { "name": "saturation", "library": "rpp", "params": { "saturation": 1.5 } },
    { "name": "color_temperature", "library": "rpp", "params": { "adjustment": 40 } },
    { "name": "color_twist", "library": "rpp", "params": { "brightness": 1.5, "contrast": 1.2, "hue": 90, "saturation": 1.5 } },
    { "name": "color_jitter", "library": "rpp", "params": { "brightness": 1.5, "contrast": 1.2, "hue": 90, "saturation": 1.5 } },
    { "name": "vignette", "library": "rpp", "params": { "intensity": 6.0 } },
    { "name": "solarize", "library": "rpp", "params": { "threshold": 0.5 } },
    { "name": "posterize", "library": "rpp", "params": { "level_bits": 4 } },
    { "name": "channel_dropout", "library": "rpp" },
    { "name": "fog", "library": "rpp", "params": { "intensity": 0.4, "grey": 0.5 } },
    { "name": "snow", "library": "rpp", "params": { "brightness_coefficient": 2.5, "threshold": 0.5, "dark_mode": 0 } },
    { "name": "gaussian_blur", "library": "rpp", "params": { "kernel_size": 3, "std_dev": 1.0 } },
    { "name": "box_filter", "library": "rpp", "params": { "kernel_size": 3 } },
    { "name": "median_filter", "library": "rpp", "params": { "kernel_size": 3 } },
    { "name": "emboss", "library": "rpp", "params": { "kernel_size": 3, "strength": 1.0 } },
    { "name": "sobel_filter", "library": "rpp", "layouts": ["PLN1"], "params": { "sobel_type": 0, "kernel_size": 3 } },
    { "name": "erode", "library": "rpp", "backends": ["HIP"], "params": { "kernel_size": 3 } },
    { "name": "dilate", "library": "rpp", "backends": ["HIP"], "params": { "kernel_size": 3 } },
    { "name": "histogram_equalize", "library": "rpp" },
    { "name": "gaussian_noise", "library": "rpp", "params": { "mean": 0.0, "std_dev": 0.2, "seed": 0 } },
    { "name": "shot_noise", "library": "rpp", "params": { "factor": 80.0, "seed": 0 } },
    { "name": "salt_and_pepper_noise", "library": "rpp", "params": { "noise_probability": 0.1, "salt_probability": 0.5, "seed": 0 } },
    { "name": "jitter", "library": "rpp", "params": { "kernel_size": 3, "seed": 0 } },
    { "name": "gridmask", "library": "rpp", "params": { "tile_width": 40, "grid_ratio": 0.6 } },
    { "name": "spatter", "library": "rpp", "params": { "r": 65, "g": 42, "b": 20 } },
    { "name": "rain", "library": "rpp", "params": { "rain_percentage": 0.03, "rain_height": 15, "alpha": 0.5 } },
    { "name": "bitwise_not", "library": "rpp" },
    { "name": "bitwise_and", "library": "rpp" },
    { "name": "bitwise_or", "library": "rpp" },
    { "name": "bitwise_xor", "library": "rpp" },
    { "name": "blend", "library": "rpp", "params": { "alpha": 0.5 } },
    { "name": "non_linear_blend", "library": "rpp", "params": { "std_dev": 50.0 } },
    { "name": "magnitude", "library": "rpp" },
    { "name": "phase", "library": "rpp" },
    { "name": "crop_and_patch", "library": "rpp" },
    { "name": "channel_permute", "library": "rpp", "params": { "perm0": 2, "perm1": 1, "perm2": 0 } },
    { "name": "color_cast", "library": "rpp", "params": { "r": 128, "g": 64, "b": 32, "alpha": 0.5 } },
    { "name": "lut", "library": "rpp" },
    { "name": "glitch", "library": "rpp", "params": { "r_x": 8, "r_y": 8, "b_x": -8, "b_y": -8 } },
    { "name": "erase", "library": "rpp" },
    { "name": "rotate", "library": "rpp", "params": { "angle": 30.0, "interpolation": "BILINEAR" } },
    { "name": "warp_affine", "library": "rpp", "params": { "angle": 30.0, "interpolation": "BILINEAR" } },
    { "name": "warp_perspective", "library": "rpp", "params": { "angle": 30.0, "interpolation": "BILINEAR" } },
    { "name": "crop", "library": "rpp", "dst_sizes": [[112, 112]] },
    { "name": "crop_mirror_normalize", "library": "rpp", "dst_sizes": [[112, 112]], "params": { "multiplier": 1.0, "mirror": 1 } },
    { "name": "resize_crop_mirror", "library": "rpp", "dst_sizes": [[112, 112]], "params": { "interpolation": "BILINEAR", "mirror": 1 } },
    { "name": "resize_mirror_normalize", "library": "rpp", "dst_sizes": [[112, 112]], "params": { "interpolation": "BILINEAR", "mirror": 1 } },
    { "name": "resize", "library": "rpp", "dst_sizes": [[112, 112]], "params": { "interpolation": "BILINEAR" } },
    { "name": "transpose", "library": "rpp", "params": { "perm": "1,0,2" } },
    { "name": "concat", "library": "rpp", "params": { "axis": 0 } },
    { "name": "tensor_and_tensor", "library": "rpp" },
    { "name": "log", "library": "rpp", "dtypes": ["F32"] },
    { "name": "add_scalar", "library": "rpp", "dtypes": ["F32"], "params": { "depth": 4 } }
  ]
}
